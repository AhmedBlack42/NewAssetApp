{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://newassetapp.local/schemas/newassetapp-import-v1.schema.json",
  "title": "NewAssetApp Training Dataset Studio import bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "bundle_id", "created_at", "producer", "registry", "records"],
  "properties": {
    "schema_version": {"const": 1},
    "bundle_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "producer": {
      "type": "object", "additionalProperties": false,
      "required": ["application", "version", "database_schema_version"],
      "properties": {
        "application": {"const": "NewAssetApp"},
        "version": {"type": "string", "minLength": 1},
        "database_schema_version": {"type": "integer", "minimum": 1}
      }
    },
    "registry": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version", "sha256"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "records": {"type": "array", "items": {"$ref": "#/$defs/record"}},
    "files": {"type": "array", "items": {"$ref": "#/$defs/file"}},
    "bundle_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "file": {
      "type": "object", "additionalProperties": false,
      "required": ["relative_path", "sha256", "bytes"],
      "properties": {
        "relative_path": {"type": "string", "minLength": 1, "not": {"pattern": "^(?:/|[A-Za-z]:[\\\\/])"}},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 0}
      }
    },
    "record": {
      "type": "object", "additionalProperties": false,
      "required": ["record_id", "task", "source", "review", "labels", "provenance"],
      "properties": {
        "record_id": {"type": "string", "minLength": 1},
        "task": {"enum": ["yolo_detection", "clothing_classification", "asset_classification"]},
        "source": {
          "type": "object", "additionalProperties": false,
          "required": ["source_image_id", "sha256", "width", "height"],
          "properties": {
            "source_image_id": {"type": "string", "minLength": 1},
            "sha256": {"$ref": "#/$defs/sha256"},
            "width": {"type": "integer", "minimum": 1},
            "height": {"type": "integer", "minimum": 1},
            "raw_filename": {"type": "string"}
          }
        },
        "detection": {
          "oneOf": [
            {"type": "null"},
            {"type": "object", "additionalProperties": false,
             "required": ["detection_id", "bbox_xyxy"],
             "properties": {
               "detection_id": {"type": "string", "minLength": 1},
               "bbox_xyxy": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}, {"type": "number"}], "minItems": 4, "maxItems": 4}
             }}
          ]
        },
        "review": {
          "type": "object", "additionalProperties": false,
          "required": ["human_confirmed", "eligible", "review_state"],
          "properties": {
            "human_confirmed": {"type": "boolean"},
            "eligible": {"type": "boolean"},
            "review_state": {"enum": ["candidate", "in_review", "reviewed", "rejected", "invalid"]},
            "exclusion_reason": {"type": ["string", "null"]}
          }
        },
        "labels": {"type": "object"},
        "provenance": {
          "type": "object", "additionalProperties": false,
          "required": ["source_snapshot_id", "created_at"],
          "properties": {
            "source_snapshot_id": {"type": "string", "minLength": 1},
            "created_at": {"type": "string", "format": "date-time"},
            "model_prediction": {"type": ["object", "null"]},
            "correction_events": {"type": "array", "items": {"type": "object"}}
          }
        }
      }
    }
  }
}
